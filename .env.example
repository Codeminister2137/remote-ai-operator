# Offline scripted mode is the only enabled execution mode in this first slice.
# Never place model credentials in browser assets or the generated-code runner.
OPERATOR_MODE=scripted

# Optional, explicit Meta mode only (also requires verified grant and live flag):
# META_API_KEY=replace-locally
# Local/phone owner credential; use at least 32 random characters:
# OPERATOR_ACCESS_TOKEN=replace-locally
# Hosted visitor mode only (`serve --hosted`): shared code, 16-256 printable
# characters, delivered out-of-band. Never commit a real value.
# OPERATOR_VISITOR_CODE=replace-locally
# Hosted session signing secret, at least 32 random characters. A stable value
# lets a browser resume its subject after a container restart; rotating it logs
# every visitor out but keeps recorded tasks. Never commit a real value.
# OPERATOR_SESSION_SECRET=replace-locally
# Modal deployment only: the final HTTPS origin (Secure cookie + exact-origin check)
# and an optional explicit finite grant file path inside the image.
# OPERATOR_PUBLIC_ORIGIN=https://example--remote-operator-hosted.modal.run
# OPERATOR_GRANT_PATH=/app/private/grant.json
